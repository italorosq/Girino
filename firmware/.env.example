# Wi-Fi — Girino
# O Girino opera como Access Point (rede própria, sem roteador).
# Copiar este arquivo para .env e ajustar se desejar outro nome/senha.
# Senha do AP precisa ter no mínimo 8 caracteres.
# NUNCA commitar o arquivo .env real!

WIFI_SSID="GIRINO_AP"
WIFI_PASSWORD="girino123"
OTA_PASSWORD="girino_ota"
